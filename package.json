{
  "name": "image-coordinate-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win zip --x64",
    "test:desktop": "npm run build && node scripts/desktop-smoke.cjs"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.0.0"
  }
}
